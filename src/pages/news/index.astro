---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const format = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="News" description="Patches, realm openings and design notes for Contested Realms.">
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Dispatches</p>
        <h1 style="font-size:clamp(2rem,5vw,3rem)">News</h1>
        <p>Patches, realm openings and design notes.</p>
      </div>

      {posts.length === 0 ? (
        <p class="muted">Nothing posted yet.</p>
      ) : (
        <div class="news-list">
          {posts.map((post) => (
            <a class="news-item" href={`/news/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>{format(post.data.date)}</time>
              <div>
                <span class="tag">{post.data.tag}</span>
                <h2 style="font-size:1.05rem;margin:0 0 0.2rem">{post.data.title}</h2>
                <p>{post.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
