---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const published = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={post.data.title} description={post.data.summary} published={post.data.date}>
  <article class="section">
    <div class="container">
      <p class="eyebrow">
        <a href="/news/" class="back-link">&larr; News</a>
      </p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{published}</time> · {post.data.tag}
      </p>

      <hr class="divider post-divider" />

      <div class="prose">
        <Content />
      </div>

      <hr class="divider post-divider" />

      <p class="post-foot">
        <a href="/news/">&larr; All news</a>
        <a href="/rss.xml">Follow by RSS</a>
      </p>
    </div>
  </article>
</Base>
